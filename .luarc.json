{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime": {
    "version": "Lua 5.5",
    "path": [
      "?.lua",
      "?/init.lua",
      "packages/?.lua",
      "packages/?/init.lua",
      "packages/shared/?.lua",
      "packages/shared/?/init.lua",
      "tests/?.lua",
      "tests/?/init.lua"
    ]
  },
  "workspace": {
    "library": ["~/.local/share/easybar/easybar_api.lua"]
  },
  "diagnostics": {
    "globals": ["easybar"]
  }
}
